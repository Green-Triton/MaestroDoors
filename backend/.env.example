# Шаблон конфигурации. Скопируйте в .env и подставьте свои значения.
#   cp .env.example .env        (Windows: copy .env.example .env)
#
# ВАЖНО: .env содержит пароль и НЕ должен попадать в git — он уже в .gitignore.

# ---------------------------------------------------------------------------
# SMTP: ящик, с которого уходят заявки
# ---------------------------------------------------------------------------
# Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# true для порта 465 (SSL), false для 587 (STARTTLS).
# Если не задать — выводится из порта.
SMTP_SECURE=true

# Полный адрес ящика-отправителя.
SMTP_USER=your.address@gmail.com

# ПАРОЛЬ ПРИЛОЖЕНИЯ, а не пароль от аккаунта.
# Гугл показывает его как 16 символов четвёрками — пробелы можно не убирать.
SMTP_PASS=xxxx xxxx xxxx xxxx

# ---------------------------------------------------------------------------
# Куда уходят заявки
# ---------------------------------------------------------------------------
RECIPIENT_EMAIL=andrey.ves@yandex.ru

# Копия в ящик SMTP_USER — заявка остаётся и у отправителя.
SEND_COPY_TO_SENDER=true

# Отображаемое имя в поле «От кого».
MAIL_FROM_NAME=Сайт ООО СК «Пирс»

# ---------------------------------------------------------------------------
# Сервер
# ---------------------------------------------------------------------------
PORT=3001

# Домены фронтенда через запятую. Пусто — разрешить любой источник
# (годится для локальной разработки, на проде лучше перечислить явно).
# Пример: ALLOWED_ORIGINS=https://green-triton.github.io,https://sk-pirs.ru
ALLOWED_ORIGINS=

# Ограничение частоты: не более RATE_LIMIT_MAX заявок с одного адреса
# за RATE_LIMIT_WINDOW_MS миллисекунд.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=5

# ---------------------------------------------------------------------------
# Другие провайдеры — раскомментируйте нужный блок вместо Gmail
# ---------------------------------------------------------------------------
# Яндекс.Почта
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
#
# Mail.ru
# SMTP_HOST=smtp.mail.ru
# SMTP_PORT=465
